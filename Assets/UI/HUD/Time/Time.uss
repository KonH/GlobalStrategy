#time-root {
    flex-direction: column;
    align-items: flex-end;
    padding: 8px 12px;
    background-color: var(--gs-panel-bg);
    border-color: var(--gs-panel-border);
    border-width: 3px;
    border-radius: 6px;
}

#time-date {
    font-size: 22px;
    color: var(--gs-color-mid);
    margin-bottom: 6px;
    -unity-font-definition: var(--gs-font-body);
}

#time-controls {
    flex-direction: row;
    align-items: center;
}

#time-controls Button {
    margin-right: 4px;
    width: 52px;
    height: 38px;
    font-size: 20px;
    border-radius: 2px;
}

.gs-icon-btn--pause {
    background-image: url("project://database/Assets/Textures/Buttons/Time/pause.png?fileID=2800000&guid=9726cb0847d1c524ba36d920eec7af79&type=3#pause");
    -unity-background-scale-mode: scale-to-fit;
}

.gs-icon-btn--play {
    background-image: url("project://database/Assets/Textures/Buttons/Time/play.png?fileID=2800000&guid=fb039fa90d6513a488f5f2821f107403&type=3#play");
    -unity-background-scale-mode: scale-to-fit;
}
