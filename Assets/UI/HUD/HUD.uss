#hud-root {
    width: 100%;
    height: 100%;
    position: absolute;
}

.top-right-panel {
    position: absolute;
    top: 6px;
    right: 6px;
    flex-direction: column;
    align-items: flex-end;
}

.time-panel {
}

.leaderboard-hud-button {
    min-width: 180px;
    height: 36px;
    font-size: 18px;
    margin-left: 12px;
}

.action-log-panel {
    position: absolute;
}

.tutorial-highlight-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.top-left-panel {
    position: absolute;
    top: 6px;
    left: 6px;
    flex-direction: row;
    align-items: flex-start;
}

.player-country-panel {
    padding: 8px 12px;
    background-color: rgb(26, 42, 72);
    border-color: rgb(200, 160, 64);
    border-width: 3px;
    border-radius: 6px;
}

.player-org-column {
    flex-direction: column;
    align-items: stretch;
    min-width: 220px;
}

.player-tasks-panel {
    margin-top: 6px;
    padding: 6px 8px;
    background-color: rgb(26, 42, 72);
    border-color: rgb(200, 160, 64);
    border-width: 2px;
    border-radius: 6px;
}

.country-info-panel {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background-color: rgb(26, 42, 72);
    border-color: rgb(200, 160, 64);
    border-top-width: 3px;
    border-left-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-radius: 0;
    padding: 16px 16px;
    flex-direction: column;
    align-items: stretch;
}

.top-center-panel {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
}

.hud-hamburger-button {
    font-size: 20px;
    width: 234px;
    height: 36px;
    margin-top: 4px;
    border-radius: 3px;
    -unity-background-scale-mode: scale-to-fit;
}

.hud-debug-toggle {
    font-size: 24px;
    height: 50px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
}

.hud-fps-label {
    margin-left: 8px;
    align-self: center;
    padding: 4px 8px;
    background-color: rgb(26, 42, 72);
    border-color: rgb(200, 160, 64);
    border-width: 1px;
    border-radius: 4px;
}

.debug-panel {
    position: absolute;
    top: 36px;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    display: none;
}

.debug-panel-scroll {
    flex-grow: 1;
    width: 100%;
    max-height: 100%;
}

.debug-panel-scroll .unity-scroll-view__content-container {
    width: 100%;
    align-items: center;
    padding-bottom: 16px;
}

.debug-panel-inner {
    background-color: rgb(26, 42, 72);
    border-color: rgb(200, 160, 64);
    border-width: 1px;
    border-radius: 4px;
    padding: 8px 16px;
    flex-direction: column;
    min-width: 260px;
    max-width: 100%;
    align-items: stretch;
    margin-top: 8px;
}

.debug-panel-two-col {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    max-width: 100%;
}

.debug-panel-col {
    flex-direction: column;
    flex-grow: 1;
    min-width: 220px;
    max-width: 100%;
    margin-right: 8px;
}

.debug-panel-inner-section {
    flex-direction: column;
    margin-left: 8px;
    margin-bottom: 4px;
}

.debug-card-block {
    flex-direction: column;
    margin-top: 2px;
}

.debug-card-header-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.debug-card-action-button {
    flex-shrink: 0;
    margin-left: 4px;
    margin-top: 8px;
}

.debug-card-details {
    flex-direction: column;
    margin-left: 12px;
}

.debug-condition-label {
    margin-top: 2px;
    font-size: 14px;
}

.debug-card-available {
    color: rgb(80, 200, 80);
}

.debug-card-unavailable {
    color: rgb(220, 70, 70);
}

.debug-panel-menu-title {
    margin-bottom: 4px;
    align-self: center;
}

.debug-panel-menu-toggle {
    min-width: 220px;
    max-width: 100%;
    margin-top: 8px;
}

.debug-panel-button {
    padding: 4px 16px;
    font-size: 16px;
    margin-top: 4px;
}

.gs-icon-btn--menu {
    background-image: url("project://database/Assets/Textures/Buttons/Menu/menu.png?fileID=2800000&guid=6192f7eb384ec334f8e2fcefbf3ec4ca&type=3#menu");
    -unity-background-scale-mode: scale-to-fit;
}

.org-lens-country-info-panel {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background-color: rgb(26, 42, 72);
    border-color: rgb(200, 160, 64);
    border-top-width: 3px;
    border-left-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-radius: 0;
    padding: 16px 16px;
    display: none;
}

.province-info-panel {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background-color: rgb(26, 42, 72);
    border-color: rgb(200, 160, 64);
    border-top-width: 3px;
    border-left-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-radius: 0;
    padding: 16px 16px;
    display: none;
}

.map-controls-panel {
    position: absolute;
    bottom: 280px;
    left: 8px;
    flex-direction: column;
    align-items: flex-start;
}

.war-icons-panel {
    margin-bottom: 6px;
}

.card-test-overlay {
    transition-property: opacity, scale;
    transition-duration: 0.4s;
}

.card-draw-overlay {
    overflow: visible;
}

.card-draw-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    overflow: visible;
}

.card-draw-slot {
    width: 240px;
    height: 360px;
    flex-shrink: 0;
}

.card-draw-card-copy {
    position: absolute;
    width: 240px;
    height: 360px;
    overflow: visible;
}

.card-draw-card-face,
.card-draw-card-back {
    position: absolute;
    left: 0;
    top: 0;
    width: 240px;
    height: 360px;
}

.character-hint-rows {
    flex-direction: column;
    margin-top: 6px;
}
