#hud-root {
    width: 100%;
    height: 100%;
    position: absolute;
}

.top-right-panel {
    position: absolute;
    top: 6px;
    right: 6px;
    flex-direction: column;
    align-items: flex-end;
}

.time-panel {
}

.leaderboard-hud-button {
    min-width: 180px;
    height: 36px;
    font-size: 18px;
    margin-left: 12px;
}

.action-log-panel {
    position: absolute;
}

.tutorial-highlight-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.top-left-panel {
    position: absolute;
    top: 6px;
    left: 6px;
    flex-direction: row;
    align-items: flex-start;
}

.player-country-panel {
    padding: 8px 12px;
    background-color: var(--gs-panel-bg);
    border-color: var(--gs-panel-border);
    border-width: 3px;
    border-radius: 6px;
}

.player-org-column {
    flex-direction: column;
    align-items: stretch;
    min-width: 220px;
}

.player-tasks-panel {
    margin-top: 6px;
    padding: 6px 8px;
    background-color: var(--gs-panel-bg);
    border-color: var(--gs-panel-border);
    border-width: 2px;
    border-radius: 6px;
    width: 320px;
}

.country-info-panel {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background-color: var(--gs-panel-bg);
    border-color: var(--gs-panel-border);
    border-top-width: 3px;
    border-left-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-radius: 0;
    padding: 16px 16px;
    flex-direction: column;
    align-items: stretch;
}

.hud-hamburger-button {
    font-size: 20px;
    width: 234px;
    height: 36px;
    margin-top: 4px;
    border-radius: 3px;
    -unity-background-scale-mode: scale-to-fit;
}

.gs-icon-btn--menu {
    background-image: url("project://database/Assets/Textures/Buttons/Menu/menu.png?fileID=2800000&guid=6192f7eb384ec334f8e2fcefbf3ec4ca&type=3#menu");
    -unity-background-scale-mode: scale-to-fit;
}

.org-lens-country-info-panel {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background-color: var(--gs-panel-bg);
    border-color: var(--gs-panel-border);
    border-top-width: 3px;
    border-left-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-radius: 0;
    padding: 16px 16px;
    display: none;
}

.province-info-panel {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background-color: var(--gs-panel-bg);
    border-color: var(--gs-panel-border);
    border-top-width: 3px;
    border-left-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-radius: 0;
    padding: 16px 16px;
    display: none;
}

.map-controls-panel {
    position: absolute;
    bottom: 280px;
    left: 8px;
    flex-direction: column;
    align-items: flex-start;
}

.war-icons-panel {
    margin-bottom: 6px;
}

.card-test-overlay {
    transition-property: opacity, scale;
    transition-duration: 0.4s;
}

.card-draw-overlay {
    overflow: visible;
}

.card-draw-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    overflow: visible;
}

.card-draw-slot {
    width: 240px;
    height: 360px;
    flex-shrink: 0;
}

.card-draw-card-copy {
    position: absolute;
    width: 240px;
    height: 360px;
    overflow: visible;
}

.card-draw-card-face,
.card-draw-card-back {
    position: absolute;
    left: 0;
    top: 0;
    width: 240px;
    height: 360px;
}

.character-hint-rows {
    flex-direction: column;
    margin-top: 6px;
}
