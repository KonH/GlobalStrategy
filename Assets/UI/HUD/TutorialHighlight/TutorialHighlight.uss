.tutorial-highlight-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-grow: 1;
}

.tutorial-highlight-arrow {
    position: absolute;
    width: 44px;
    height: 40px;
    background-image: url("project://database/Assets/Textures/Tutorial/tutorial_arrow_right.png?fileID=2800000&guid=c08facc465ec15945a39f26599f0b76c&type=3#tutorial_arrow_right");
    -unity-background-scale-mode: scale-to-fit;
}
