.org-destroyed-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.org-destroyed-panel {
    position: relative;
    width: 84%;
    max-width: 1080px;
    min-height: 630px;
    padding: 28px 36px 32px;
    align-items: center;
}

.org-destroyed-header {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    align-self: stretch;
    margin-bottom: 18px;
    padding-right: 56px;
}

.org-destroyed-title {
    font-size: 32px;
    color: var(--gs-color-parchment);
    -unity-text-align: middle-center;
    white-space: normal;
}

.org-destroyed-close {
    position: absolute;
    top: 26px;
    right: 32px;
    width: 52px;
    height: 46px;
    font-size: 24px;
}

.org-destroyed-image {
    flex-grow: 1;
    width: 100%;
    height: 0;
    margin-bottom: 18px;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/Textures/Events/org_destroy.png?fileID=-4708184861480362668&guid=3e3b37d045b94a199196e7b75e314f75&type=3#org_destroy_0");
}

.org-destroyed-body {
    align-self: stretch;
    flex-shrink: 0;
    margin-top: 8px;
    margin-bottom: 24px;
    font-size: 20px;
    color: var(--gs-color-muted-light);
    -unity-text-align: middle-center;
    white-space: normal;
}

.org-destroyed-confirm {
    width: 240px;
    height: 52px;
    font-size: 24px;
    flex-shrink: 0;
    margin-bottom: 8px;
}
