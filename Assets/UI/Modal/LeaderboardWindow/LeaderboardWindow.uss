.leaderboard-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.leaderboard-panel {
    position: relative;
    width: 78%;
    height: 82%;
    padding: 26px 32px;
}

.leaderboard-header {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 18px;
}

.leaderboard-title {
    font-size: 38px;
}

.leaderboard-close {
    position: absolute;
    top: 26px;
    right: 32px;
    width: 52px;
    height: 46px;
    font-size: 24px;
}

.leaderboard-tabs {
    flex-direction: row;
    margin-bottom: 12px;
}

.leaderboard-tab {
    min-width: 220px;
    height: 48px;
    margin-right: 12px;
    font-size: 24px;
}

.leaderboard-tab--active {
    border-color: var(--gs-color-highlight-gold);
    border-width: 3px;
}

.leaderboard-table-header {
    flex-direction: row;
    align-items: center;
    align-self: stretch;
    padding: 6px 10px;
    padding-right: 26px;
    margin-bottom: 4px;
    border-bottom-width: 1px;
    border-color: var(--gs-panel-border);
}

/* .leaderboard-header-* used to share width rules with the row's own place/flag/name/score
   classes. Rows now build as the shared RankRow component (rank-row-*, Components.uss) - the
   header keeps its own matching widths here so the columns still line up. */
.leaderboard-header-place {
    width: 70px;
    -unity-text-align: middle-center;
}

.leaderboard-header-flag {
    width: 56px;
    height: 36px;
    margin-right: 14px;
}

.leaderboard-header-name {
    flex-grow: 1;
    flex-shrink: 1;
}

.leaderboard-header-score {
    width: 180px;
    -unity-text-align: middle-right;
}

.leaderboard-list {
    flex-grow: 1;
    align-self: stretch;
}

.leaderboard-table-header Label {
    color: var(--gs-color-dark);
    font-size: 22px;
    -unity-font-style: bold;
}

.leaderboard-empty {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    -unity-text-align: middle-center;
    color: var(--gs-color-dark);
    font-size: 26px;
}
