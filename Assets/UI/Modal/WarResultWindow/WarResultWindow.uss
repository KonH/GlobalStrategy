.war-result-panel {
    /* Title + winner stay fixed; body scrolls so the results block is never clipped. */
}

.war-result-winner {
    align-self: center;
    flex-shrink: 0;
    font-size: 28px;
    margin-bottom: 10px;
    -unity-text-align: middle-center;
}

.war-result-body {
    flex-grow: 1;
    flex-shrink: 1;
    align-self: stretch;
    min-height: 0;
}

.war-result-panel .war-progress-side-header {
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
}

.war-result-panel .war-progress-side-flag {
    flex-shrink: 0;
}

.war-result-panel .war-progress-side-label {
    flex-shrink: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.war-result-battles-list {
    flex-grow: 0;
    flex-shrink: 0;
    max-height: 120px;
    min-height: 72px;
    margin-bottom: 8px;
}

.war-result-battles-empty {
    position: relative;
    left: auto;
    right: auto;
    bottom: auto;
    margin-bottom: 8px;
}

.war-result-section-title {
    margin-top: 4px;
    flex-shrink: 0;
}

.war-result-results {
    flex-grow: 0;
    flex-shrink: 0;
    align-self: stretch;
    min-height: 160px;
    margin-bottom: 8px;
}

.war-result-subsection-title {
    align-self: stretch;
    margin-top: 8px;
    margin-bottom: 4px;
    -unity-font-style: bold;
}

.war-result-list {
    align-self: stretch;
    margin-bottom: 4px;
}

.war-result-row {
    align-self: stretch;
    margin-bottom: 2px;
    font-size: 18px;
    color: var(--gs-color-mid);
    white-space: normal;
}

.war-result-gold-header {
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    align-self: stretch;
    margin-top: 8px;
    margin-bottom: 4px;
}

.war-result-gold-header-label {
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 6px;
}

.war-result-gold-icon {
    flex-shrink: 0;
}

.war-result-gold-country {
    -unity-font-style: bold;
    margin-top: 4px;
}

.war-result-gold-amount {
    margin-left: 8px;
}

/* .war-result-province-row/-arrow/-name moved to Components.uss as
   .province-transfer-row/-arrow/-name (ProvinceTransferRow component). Sizing only stays here -
   the flag-badge component class (Components.uss) owns picking mode and scale mode. */
.war-result-province-flag {
    width: 28px;
    height: 20px;
}
