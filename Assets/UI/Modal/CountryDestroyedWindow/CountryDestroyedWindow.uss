.country-destroyed-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.country-destroyed-panel {
    position: relative;
    width: 56%;
    max-width: 720px;
    min-height: 420px;
    padding: 28px 36px 32px;
    align-items: center;
    background-color: rgba(10, 12, 18, 0.96);
    border-color: rgb(96, 72, 48);
}

.country-destroyed-header {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    align-self: stretch;
    margin-bottom: 18px;
    padding-right: 56px;
}

.country-destroyed-title {
    font-size: 32px;
    color: rgb(220, 200, 160);
    -unity-text-align: middle-center;
    white-space: normal;
}

.country-destroyed-close {
    position: absolute;
    top: 26px;
    right: 32px;
    width: 52px;
    height: 46px;
    font-size: 24px;
}

.country-destroyed-image {
    flex-shrink: 0;
    width: 100%;
    max-width: 520px;
    height: 220px;
    margin-bottom: 18px;
    background-color: rgba(0, 0, 0, 0.35);
    border-width: 1px;
    border-color: rgb(72, 56, 40);
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/Textures/Events/country_destroy.png?fileID=-2064606585841019640&guid=6d8cda9888878cd4a8a1d301eb75db59&type=3#country_destroy_0");
}

.country-destroyed-body {
    align-self: stretch;
    margin-bottom: 24px;
    font-size: 20px;
    color: rgb(188, 176, 148);
    -unity-text-align: middle-center;
    white-space: normal;
}

.country-destroyed-confirm {
    width: 240px;
    height: 52px;
    font-size: 24px;
    flex-shrink: 0;
}
