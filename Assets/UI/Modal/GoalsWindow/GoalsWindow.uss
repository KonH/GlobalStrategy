.goals-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.goals-panel {
    position: relative;
    width: 86%;
    height: 82%;
    padding: 26px 32px;
}

.goals-header {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 18px;
}

.goals-title {
    font-size: 38px;
}

.goals-close {
    position: absolute;
    top: 26px;
    right: 32px;
    width: 52px;
    height: 46px;
    font-size: 24px;
}

.goals-body {
    flex-direction: row;
    flex-grow: 1;
    align-self: stretch;
    min-height: 0;
}

.goals-left {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    margin-right: 18px;
    min-width: 0;
    min-height: 0;
}

.goals-right {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    min-height: 0;
}

.goals-table-header {
    flex-direction: row;
    align-items: center;
    align-self: stretch;
    padding: 6px 10px;
    padding-right: 26px;
    margin-bottom: 4px;
    border-bottom-width: 1px;
    border-color: var(--gs-panel-border);
}

/* .goals-header-*/.goals-row-* used to share width rules with the row's own place/flag/name/score
   classes. Rows now build as the shared RankRow component (rank-row-*, Components.uss) - the
   header keeps its own matching widths here so the columns still line up. */
.goals-header-place {
    width: 70px;
    -unity-text-align: middle-center;
}

.goals-header-flag {
    width: 56px;
    height: 36px;
    margin-right: 14px;
}

.goals-header-name {
    flex-grow: 1;
    flex-shrink: 1;
}

.goals-header-score {
    width: 180px;
    -unity-text-align: middle-right;
}

.goals-org-list,
.goals-progress-list {
    align-self: stretch;
}

.goals-progress-header-spacer {
    opacity: 0;
}

.goals-table-header Label {
    color: var(--gs-color-dark);
    font-size: 22px;
    -unity-font-style: bold;
}

.goals-progress-row {
    flex-direction: row;
    align-items: center;
    min-height: 54px;
    margin-bottom: 4px;
}

.goals-progress-description {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 16px;
    color: var(--gs-color-dark);
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    white-space: normal;
}

.goals-progress-track {
    position: relative;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-grow: 0;
    flex-shrink: 0;
    width: 33%;
    height: 52px;
    background-color: rgba(20, 30, 50, 0.9);
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--gs-panel-border);
    overflow: hidden;
}

.goals-progress-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0%;
    background-color: var(--gs-color-highlight-gold);
}

.goals-progress-nm {
    color: var(--gs-color-white);
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
