<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/UI/Shared/SharedStyles.uss" />
    <ui:Style src="project://database/Assets/UI/Overlay/OrgInfo/OrgActions.uss" />
    <ui:Style src="project://database/Assets/UI/HUD/CountryInfo/CountryInfo.uss" />
    <ui:Style src="project://database/Assets/UI/HUD/PlayerTasks/PlayerTasks.uss" />
    <ui:Style src="project://database/Assets/UI/HUD/HUD.uss" />
    <ui:Style src="project://database/Assets/UI/HUD/ProvinceInfo/ProvinceInfo.uss" />
    <ui:Style src="project://database/Assets/UI/HUD/PlayerCountry/PlayerCountry.uss" />
    <ui:Style src="project://database/Assets/UI/HUD/Time/Time.uss" />
    <ui:Style src="project://database/Assets/UI/HUD/LensSwitcher/LensSwitcher.uss" />
    <ui:Style src="project://database/Assets/UI/HUD/OrgLensCountryInfo/OrgLensCountryInfo.uss" />
    <ui:Style src="project://database/Assets/UI/HUD/ActionLog/ActionLog.uss" />
    <ui:Style src="project://database/Assets/UI/HUD/WarIcons/WarIcons.uss" />
    <ui:Style src="project://database/Assets/UI/HUD/TutorialHighlight/TutorialHighlight.uss" />
    <ui:Style src="project://database/Assets/UI/FlyText/FlyText.uss" />
    <ui:Style src="project://database/Assets/UI/Components/Components.uss" />
    <ui:Style src="project://database/Assets/UI/Gallery/Gallery.uss" />
    <ui:VisualElement name="gallery-root" class="gallery-root">
        <ui:Label text="UI Gallery" name="gallery-header" class="gs-header gallery-header" />
        <ui:ScrollView name="gallery-scroll" class="gallery-scroll" mode="Vertical">
            <ui:VisualElement name="gallery-blocks" class="gallery-blocks" />
        </ui:ScrollView>
        <ui:VisualElement name="gallery-focus-root" class="gallery-focus-root">
            <ui:VisualElement name="gallery-focus-bar" class="gallery-focus-bar">
                <ui:Button text="Back to Gallery" name="gallery-focus-back-button" class="gs-btn gs-btn--small gallery-focus-back-button" />
                <ui:Label text="" name="gallery-focus-title" class="gs-header gallery-focus-title" />
            </ui:VisualElement>
            <ui:VisualElement name="gallery-focus-content" class="gallery-focus-content" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
