/* ===== Design tokens =====
   Mirrors the palette vocabulary in Design/01_prototype/design-final.html (prefixed --gs-).
   Values capture the existing look exactly — this declaration does not change any colour or
   font. Extended tokens (not present in the prototype) cover values already in use in this
   project's own stylesheets, named for what they represent. */

:root {
    /* Core palette (prototype-mirrored) */
    --gs-panel-bg: rgb(26, 42, 72);
    --gs-panel-border: rgb(200, 160, 64);
    --gs-btn-bg: rgb(36, 50, 88);
    --gs-btn-hover: rgb(46, 64, 112);
    --gs-btn-active: rgb(200, 160, 64);
    --gs-btn-destructive-bg: rgb(106, 24, 24);
    --gs-btn-destructive-border: rgb(154, 32, 32);
    --gs-btn-destructive-text: rgb(248, 232, 200);
    --gs-toggle-off: rgb(36, 50, 88);
    --gs-toggle-on: rgb(200, 160, 64);
    --gs-toggle-on-hover: rgb(176, 140, 48);
    --gs-tooltip-bg: rgb(18, 32, 58);
    --gs-color-dark: rgb(240, 232, 208);
    --gs-color-mid: rgb(200, 184, 144);
    --gs-color-hint: rgb(136, 136, 168);
    --gs-color-light: rgb(240, 232, 208);
    --gs-color-positive: rgb(80, 216, 112);
    --gs-color-negative: rgb(224, 64, 64);
    --gs-font-title: url("/Assets/UI/Fonts/Cinzel-Bold SDF.asset");
    --gs-font-header: url("/Assets/UI/Fonts/Cinzel-Bold SDF.asset");
    --gs-font-body: url("/Assets/UI/Fonts/IMFellEnglish-Regular SDF.asset");
    --gs-font-hint: url("/Assets/UI/Fonts/IMFellEnglish-Italic SDF.asset");

    /* Extended palette (project-specific, not in the prototype) */
    --gs-color-attacker: rgb(200, 64, 64);
    --gs-color-defender: rgb(64, 112, 200);
    --gs-color-gold: rgb(212, 175, 55);
    --gs-bg-attacker: rgb(200, 64, 64);
    --gs-bg-defender: rgb(64, 112, 200);
    --gs-btn-secondary-bg: rgb(28, 40, 64);
    --gs-btn-speed-bg: rgb(30, 80, 48);
    --gs-btn-speed-text: rgb(144, 255, 184);
    --gs-btn-speed-border: rgb(42, 112, 64);
    --gs-btn-disabled-bg: rgb(46, 50, 60);
    --gs-btn-disabled-border: rgb(90, 94, 104);
    --gs-btn-disabled-text: rgb(218, 218, 224);
    --gs-border-muted: rgb(160, 128, 48);
    --gs-border-muted-warm: rgb(139, 109, 56);
    --gs-overlay-bg: rgba(0, 0, 0, 0.5);
    --gs-blackfade-bg: rgba(0, 0, 0, 0.4);
    --gs-color-black: rgb(0, 0, 0);
    --gs-color-white: rgb(255, 255, 255);
    --gs-color-highlight-gold: rgb(240, 200, 96);
    --gs-color-parchment: rgb(220, 200, 160);
    --gs-color-muted-light: rgb(188, 176, 148);
    --gs-bg-row-overlay: rgba(8, 14, 30, 0.45);

    /* Character card system (used only within this stylesheet today) */
    --gs-char-org-card-bg: rgb(10, 10, 18);
    --gs-char-org-card-border-empty: rgb(102, 102, 102);
    --gs-char-card-bg: rgb(14, 26, 46);
    --gs-char-org-info-bg: rgb(18, 16, 26);
    --gs-char-stat-chip-bg: rgb(22, 30, 48);
    --gs-char-text-brown: rgb(80, 55, 20);
    --gs-char-portrait-bg: rgb(106, 136, 152);
    --gs-char-status-empty: rgb(130, 120, 110);
    --gs-char-org-role: rgb(136, 102, 64);
    --gs-char-status-available: rgb(150, 200, 100);
    --gs-char-org-card-border: rgb(160, 120, 24);
    --gs-char-org-info-border: rgb(106, 80, 16);
    --gs-char-org-name: rgb(212, 168, 64);
    --gs-char-card-bg-light: rgb(240, 228, 196);
    --gs-char-name-overlay-bg: rgba(14, 26, 46, 0.75);
    --gs-char-portrait-empty-bg: rgba(50, 40, 30, 0.6);
    --gs-char-portrait-empty-border: rgba(100, 80, 60, 0.4);
}

/* ===== Panel ===== */

.gs-panel {
    background-color: var(--gs-panel-bg);
    border-color: var(--gs-panel-border);
    border-width: 2px;
    border-radius: 6px;
    flex-direction: column;
    align-items: center;
}

/* ===== Overlay / Modal backdrop ===== */

.gs-modal-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--gs-overlay-bg);
}

.gs-blackfade {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--gs-blackfade-bg);
}

/* ===== Text ===== */

.gs-title {
    font-size: 42px;
    color: var(--gs-color-dark);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-font-definition: var(--gs-font-title);
}

.gs-header {
    font-size: 36px;
    color: var(--gs-color-dark);
    -unity-font-style: bold;
    -unity-font-definition: var(--gs-font-header);
}

.gs-label {
    font-size: 20px;
    color: var(--gs-color-mid);
    -unity-font-definition: var(--gs-font-body);
}

.gs-content {
    font-size: 18px;
    color: var(--gs-color-mid);
    -unity-font-definition: var(--gs-font-body);
}

.gs-hint {
    font-size: 16px;
    color: var(--gs-color-hint);
    -unity-font-definition: var(--gs-font-hint);
}

/* ===== Buttons ===== */

.gs-btn {
    background-color: var(--gs-btn-bg);
    color: var(--gs-color-dark);
    border-color: var(--gs-panel-border);
    border-width: 1px;
    border-radius: 4px;
    -unity-font-style: bold;
    -unity-font-definition: var(--gs-font-body);
}

.gs-btn:hover {
    background-color: var(--gs-btn-hover);
}

.gs-btn:disabled {
    background-color: var(--gs-btn-disabled-bg);
    border-color: var(--gs-btn-disabled-border);
    color: var(--gs-btn-disabled-text);
}

.gs-btn--primary {
    height: 60px;
    margin-bottom: 14px;
    font-size: 30px;
    -unity-font-definition: var(--gs-font-title);
}

.gs-btn--secondary {
    background-color: var(--gs-btn-secondary-bg);
    border-color: var(--gs-panel-border);
}

.gs-btn--small {
    font-size: 20px;
    -unity-font-style: bold;
    -unity-font-definition: var(--gs-font-header);
}

.gs-btn--destructive {
    background-color: var(--gs-btn-destructive-bg);
    border-color: var(--gs-btn-destructive-border);
    color: var(--gs-btn-destructive-text);
}

.gs-btn--active {
    background-color: var(--gs-btn-active);
    color: var(--gs-color-dark);
    border-color: var(--gs-panel-border);
}

.gs-btn--speed {
    background-color: var(--gs-btn-speed-bg);
    color: var(--gs-btn-speed-text);
    border-color: var(--gs-btn-speed-border);
}

/* ===== Toggle buttons ===== */

.gs-toggle-on {
    background-color: var(--gs-toggle-on);
    color: var(--gs-color-dark);
    border-color: var(--gs-panel-border);
}

.gs-toggle-on:hover {
    background-color: var(--gs-toggle-on-hover);
}

.gs-toggle-off {
    background-color: var(--gs-toggle-off);
    color: var(--gs-color-dark);
    border-color: var(--gs-panel-border);
}

/* ===== Icons ===== */

.gs-icon {
    width: 14px;
    height: 14px;
}

.gs-icon--coin {
    width: 13px;
    height: 13px;
}

/* --- Stat icon size base (used for in-card / HUD icons) --- */
.gs-icon--stat {
    width: 20px;
    height: 20px;
    -unity-background-scale-mode: scale-to-fit;
}

.gs-icon--png-coin {
    background-image: url("project://database/Assets/Textures/Icons/CardView/coin.png?fileID=2800000&guid=7fccafa14706457483a5f3c19e7c1746&type=3#coin");
}

/* ===== Colour utility classes =====
   Declared last so they override compound class colours when combined
   (e.g. gs-label sets a base colour; gs-color-positive overrides it). */

.gs-bg-panel { background-color: var(--gs-panel-bg); }
.gs-bg-button { background-color: var(--gs-btn-bg); }
.gs-bg-button-hover { background-color: var(--gs-btn-hover); }
.gs-bg-button-active { background-color: var(--gs-btn-active); }
.gs-bg-tooltip { background-color: var(--gs-tooltip-bg); }

.gs-border-primary { border-color: var(--gs-panel-border); }
.gs-border-muted { border-color: var(--gs-border-muted); }

.gs-color-dark { color: var(--gs-color-dark); }
.gs-color-mid { color: var(--gs-color-mid); }
.gs-color-hint { color: var(--gs-color-hint); }
.gs-color-positive { color: var(--gs-color-positive); }
.gs-color-negative { color: var(--gs-color-negative); }
.gs-color-light { color: var(--gs-color-light); }
.gs-color-attacker { color: var(--gs-color-attacker); }
.gs-color-defender { color: var(--gs-color-defender); }
.gs-color-gold { color: var(--gs-color-gold); }
.gs-bg-attacker { background-color: var(--gs-bg-attacker); }
.gs-bg-defender { background-color: var(--gs-bg-defender); }

/* ===== Resource row ===== */

.resources-container {
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
}

/* .resource-row/.resource-icon/.resource-label moved into Components.uss as .resource-chip /
   .resource-chip-icon / .resource-chip-label (ResourceChip component). .resource-row--spaced and
   the .resource-icon--* tint variants stay here - still layout/asset references, not colour
   literals, and .resource-icon--coin is also used standalone (WarResultWindowView). */

.resource-row--spaced {
    margin-left: 12px;
}

.resource-icon--coin {
    background-image: url("project://database/Assets/Textures/Icons/ResourceRow/coin.png");
}

.resource-icon--country-population {
    background-image: url("project://database/Assets/Textures/Icons/ResourceRow/resource-country-population.png");
}

.resource-icon--country-recruits {
    background-image: url("project://database/Assets/Textures/Icons/ResourceRow/resource-country-recruits.png");
}

.resource-icon--country-score {
    background-image: url("project://database/Assets/Textures/Icons/ResourceRow/resource-country-score.png");
}

.resource-icon--org-score {
    background-image: url("project://database/Assets/Textures/Icons/ResourceRow/resource-org-score.png");
}

/* ===== Tooltips ===== */

.tooltip-overlay {
    position: absolute;
    background-color: var(--gs-tooltip-bg);
    border-color: var(--gs-panel-border);
    border-width: 2px;
    border-radius: 6px;
    padding: 8px 12px;
    min-width: 160px;
}

.tooltip-overlay--pinned {
    border-color: var(--gs-color-highlight-gold);
    border-width: 3px;
}

.tooltip-inner-trigger {
    border-bottom-width: 1px;
    border-color: var(--gs-color-mid);
    cursor: link;
}

.tooltip-header {
    font-size: 16px;
    color: var(--gs-color-dark);
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.tooltip-effect-row {
    margin-top: 4px;
    padding: 1px 0;
}

.tooltip-effect-name {
    font-size: 14px;
    color: var(--gs-color-mid);
    -unity-font-style: bold;
}

.tooltip-effect-positive {
    color: var(--gs-color-positive);
}

.tooltip-effect-hint {
    color: var(--gs-color-hint);
}

.tooltip-effect-negative {
    color: var(--gs-color-negative);
}

.tooltip-description {
    font-size: 13px;
    color: var(--gs-color-hint);
    margin-top: 2px;
    white-space: normal;
    -unity-font-style: italic;
}

/* ===== Characters toggle button ===== */

.chars-toggle-btn {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

/* ===== Characters container ===== */

.characters-container {
    flex-direction: row;
    flex-wrap: wrap;
    padding-bottom: 8px;
}

/* ===== Character cards ===== */

.character-card {
    flex-direction: column;
    align-items: center;
    width: 180px;
    margin: 4px;
    padding: 6px;
    border-width: 1px;
    border-color: var(--gs-border-muted-warm);
    border-radius: 4px;
    background-color: var(--gs-char-card-bg-light);
}

.character-card--empty {
    opacity: 0.5;
}

.role-block {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.character-name {
    font-size: 18px;
    -unity-text-align: upper-center;
    white-space: normal;
    color: var(--gs-char-text-brown);
    -unity-font-style: bold;
    margin-bottom: 4px;
    min-height: 50px;
}

.character-portrait {
    width: 160px;
    height: 140px;
    margin-bottom: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.character-portrait--empty {
    background-color: var(--gs-char-portrait-empty-bg);
    border-color: var(--gs-char-portrait-empty-border);
}

.character-slot-status {
    font-size: 14px;
    -unity-text-align: middle-center;
    margin-top: 4px;
}

.character-slot-status--available {
    color: var(--gs-char-status-available);
}

.character-slot-status--empty {
    color: var(--gs-char-status-empty);
}

.skills-block {
    flex-direction: row;
    justify-content: flex-start;
    flex-wrap: wrap;
    width: 100%;
}

.skill-chip {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-basis: 50%;
    padding: 3px 2px;
}

.skill-value {
    font-size: 28px;
    color: var(--gs-char-text-brown);
}

/* ===== Character skill icons ===== */

.character-skill-icon--power,
.character-skill-icon--charm,
.character-skill-icon--stinginess,
.character-skill-icon--intrigue {
    -unity-background-scale-mode: scale-to-fit;
}

.character-skill-icon--power {
    background-image: url("project://database/Assets/Textures/Icons/CharacterSkill/skill-power.png?fileID=2800000&guid=40c23588446148b4f9983d5aa8b06329&type=3#skill-power");
}

.character-skill-icon--charm {
    background-image: url("project://database/Assets/Textures/Icons/CharacterSkill/skill-charm.png?fileID=2800000&guid=667b4b5ab5d58bb499594532a3b18924&type=3#skill-charm");
}

.character-skill-icon--stinginess {
    background-image: url("project://database/Assets/Textures/Icons/CharacterSkill/skill-stinginess.png?fileID=2800000&guid=a37655faf32f1b64aad9cbd422d6fa8f&type=3#skill-stinginess");
}

.character-skill-icon--intrigue {
    background-image: url("project://database/Assets/Textures/Icons/CharacterSkill/skill-intrigue.png?fileID=2800000&guid=731e23065e3402841aa8309477c1d971&type=3#skill-intrigue");
}

/* ===== Compact country character card (.char-card) ===== */

.char-card {
    flex-direction: column;
    width: 160px;
    margin: 4px;
    border-width: 1px;
    border-color: var(--gs-panel-border);
    border-radius: 4px;
    overflow: hidden;
    background-color: var(--gs-char-card-bg);
}

.char-portrait-area {
    width: 160px;
    height: 160px;
    overflow: hidden;
    background-color: var(--gs-char-portrait-bg);
    align-items: center;
    justify-content: center;
    -unity-background-scale-mode: scale-and-crop;
}

.char-name-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background-color: var(--gs-char-name-overlay-bg);
    padding: 3px 5px;
}

.char-opinion {
    font-size: 14px;
    -unity-font-style: bold;
    margin-top: 2px;
}

.char-info {
    padding: 4px 5px;
    background-color: var(--gs-panel-bg);
    flex-direction: column;
    flex: 1;
}

.char-name {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--gs-color-dark);
    white-space: normal;
    -unity-font-definition: var(--gs-font-header);
}

.char-role {
    font-size: 14px;
    -unity-font-style: italic;
    color: var(--gs-color-hint);
    -unity-font-definition: var(--gs-font-hint);
}

.char-stats {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: auto;
}

.char-stat-chip {
    flex-direction: row;
    align-items: center;
    font-size: 14px;
    color: var(--gs-color-mid);
    flex-basis: 50%;
    background-color: var(--gs-char-stat-chip-bg);
    border-radius: 2px;
    padding: 2px 4px;
}

.char-stat-icon {
    width: 14px;
    height: 14px;
    -unity-background-scale-mode: scale-to-fit;
    margin-right: 2px;
}

/* ===== Org character card (.org-char-card) ===== */

.org-char-card {
    flex-direction: column;
    width: 160px;
    margin: 4px;
    border-width: 2px;
    border-color: var(--gs-char-org-card-border);
    border-radius: 4px;
    overflow: hidden;
    background-color: var(--gs-char-org-card-bg);
}

.org-char-card--empty {
    border-color: var(--gs-char-org-card-border-empty);
    opacity: 0.5;
}

.org-portrait-area {
    width: 160px;
    height: 160px;
    overflow: hidden;
    background-color: var(--gs-char-org-card-bg);
    align-items: center;
    justify-content: center;
    -unity-background-scale-mode: scale-and-crop;
}

.org-portrait-area--empty {
    background-color: var(--gs-char-org-card-bg);
}

.org-info-block {
    padding: 4px 5px;
    flex-direction: column;
    background-color: var(--gs-char-org-info-bg);
    border-top-width: 1px;
    border-color: var(--gs-char-org-info-border);
}

.org-char-name {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--gs-char-org-name);
    white-space: normal;
    -unity-font-definition: var(--gs-font-header);
}

.org-char-role {
    font-size: 14px;
    -unity-font-style: italic;
    color: var(--gs-char-org-role);
    -unity-font-definition: var(--gs-font-hint);
}

.org-char-stats {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 2px;
}

/* ===== Flag + name row ===== */

.flag-name-row {
    flex-direction: row;
    align-items: center;
}

/* Sizing/margin only - the flag-badge component class (Components.uss) owns picking mode and
   scale mode. */
.entity-flag {
    width: 64px;
    height: 64px;
    margin-right: 8px;
}
