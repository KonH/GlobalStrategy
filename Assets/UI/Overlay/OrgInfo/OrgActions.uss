.org-actions-root {
    flex-direction: row;
    padding: 8px;
    min-width: 600px;
}

.hand-section {
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    overflow: visible;
}

.hand-container {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
    overflow: visible;
}

.card-lift-wrapper {
    margin: 0 8px 8px 8px;
    overflow: visible;
}

.action-deck-wrapper {
    margin-right: 40px;
}

/* Card shell */
.action-card {
    width: 240px;
    height: 300px;
    flex-direction: column;
    border-width: 2px;
    border-radius: 4px;
    overflow: hidden;
    background-color: rgb(212, 196, 160);
}

.action-card--available {
    border-color: rgb(136, 204, 255);
}

.action-card--unavailable {
    border-color: rgb(139, 109, 56);
    opacity: 0.55;
}

.action-card--success {
    border-color: rgb(40, 168, 74);
}

.action-card--fail {
    border-color: rgb(224, 64, 64);
}

/* Header bar */
.action-card-header {
    height: 32px;
    background-color: rgb(26, 42, 72);
    color: rgb(240, 232, 208);
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding: 0;
    border-bottom-width: 1px;
    border-color: rgb(200, 160, 64);
    white-space: nowrap;
    overflow: hidden;
    -unity-font-definition: url("/Assets/UI/Fonts/Cinzel-Bold SDF.asset");
}

/* Art area */
.action-card-art {
    width: 100%;
    height: 130px;
    padding: 0 6px;
    overflow: hidden;
}

.action-card-art-image {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-and-crop;
}

.action-card-war-win-chance {
    position: absolute;
    top: 4px;
    right: 6px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    justify-content: center;
    align-items: center;
    -unity-text-align: middle-center;
    font-size: 16px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("/Assets/UI/Fonts/Cinzel-Bold SDF.asset");
    -unity-font-style: bold;
}

.action-card-war-win-chance--low {
    background-color: rgb(176, 40, 40);
}

.action-card-war-win-chance--mid {
    background-color: rgb(196, 160, 32);
}

.action-card-war-win-chance--high {
    background-color: rgb(40, 140, 56);
}

/* Body */
.action-card-body {
    padding: 5px 6px;
    flex: 1;
    flex-direction: column;
}

.action-card-desc {
    font-size: 18px;
    color: rgb(58, 40, 16);
    white-space: normal;
    flex: 1;
    min-height: 0;
    overflow: hidden;
    -unity-font-definition: url("/Assets/UI/Fonts/IMFellEnglish-Regular SDF.asset");
}

.action-card-success-pct {
    font-size: 16px;
    color: rgb(136, 136, 168);
    -unity-font-definition: url("/Assets/UI/Fonts/IMFellEnglish-Regular SDF.asset");
}

/* Footer row: chance % on left, cost on right — inline inside body */
.action-card-footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 2px 6px 4px;
    flex-shrink: 0;
}

/* Cost section inside footer — no background, inline */
.action-card-cost {
    flex-direction: row;
    align-items: center;
}

.action-card-cost-label {
    font-size: 16px;
    color: rgb(42, 26, 8);
    margin-right: 4px;
    -unity-font-definition: url("/Assets/UI/Fonts/Cinzel-Bold SDF.asset");
}

.action-card-cost-label--unaffordable {
    color: rgb(224, 64, 64);
}

.action-card-cost-icon {
    width: 16px;
    height: 16px;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/Textures/Icons/CardView/coin.png?fileID=2800000&guid=7fccafa14706457483a5f3c19e7c1746&type=3#coin");
}
