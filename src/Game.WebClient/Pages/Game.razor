@page "/game"
@using System.Collections.Generic
@using System.Threading
@using GS.Main
@using GS.Game.WebClient.Services
@implements IDisposable
@inject GameSession GameSession
@inject IGameClient Client
@inject Localization Localization
@inject NavigationManager Navigation

@if (Client.HasSession || HostMode.IsRemote(Navigation.Uri)) {
	<div class="gs-game-view">
		<GameToolbar ShowMenu="Client.ShowPauseMenu" MenuLabel="@Localization.Get("game_menu.title")" OnMenu="OnMenu" Time="Client.Time" />
		<FreezeTick />

		@if (Client.Completion != null && Client.Completion.IsCompleted) {
			<div class="gs-completion-banner">
				@if (Client.Completion.Result == GameResult.Win) {
					<span>You won! Winner: @WinnerDisplayName()</span>
				} else {
					<span>You lost. Winner: @WinnerDisplayName()</span>
				}
			</div>
		}

		<div class="gs-game-content">
			<ActionsLog GameLog="ResolveLog()" />
			<EcsInspector />
		</div>

		<Terminal />

		@if (_menuOpen && Client.ShowPauseMenu) {
			<div class="gs-modal-overlay">
				<div class="gs-modal-panel">
					<h2>@Localization.Get("game_menu.title")</h2>
					<button @onclick="OnResume">@Localization.Get("game_menu.resume")</button>
					<button @onclick="OnSave">@Localization.Get("game_menu.save")</button>
					@if (_saveMessage != null) {
						<div class="gs-save-message">@_saveMessage</div>
					}
					<button @onclick="OnExit">@Localization.Get("game_menu.exit")</button>
				</div>
			</div>
		}
	</div>
}

@code {
	bool _menuOpen;
	string? _saveMessage;
	bool _subscribed;
	CancellationTokenSource? _pollCts;

	protected override async Task OnInitializedAsync() {
		if (HostMode.ShouldRedirectToMenu(Navigation.Uri, GameSession.Logic != null)) {
			Navigation.NavigateTo("/");
			return;
		}

		Client.Changed += OnChanged;
		_subscribed = true;
		if (HostMode.IsRemote(Navigation.Uri)) {
			_pollCts = new CancellationTokenSource();
			_ = PollLoop(_pollCts.Token);
			await Client.RefreshHudAsync();
			await Client.RefreshSnapshotAsync();
		} else {
			await Client.RefreshHudAsync();
			await Client.RefreshSnapshotAsync();
		}
	}

	async Task PollLoop(CancellationToken token) {
		int ticks = 0;
		using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(400));
		try {
			while (await timer.WaitForNextTickAsync(token)) {
				await Client.RefreshHudAsync();
				ticks++;
				if (ticks % 10 == 0) {
					await Client.RefreshSnapshotAsync();
				}
			}
		} catch (OperationCanceledException) {
		}
	}

	void OnChanged() {
		InvokeAsync(StateHasChanged);
	}

	readonly GameLogState _remoteLog = new GameLogState();

	GameLogState ResolveLog() {
		if (GameSession.Logic != null) {
			return GameSession.Logic.VisualState.GameLog;
		}
		if (Client.LogEntries != null) {
			_remoteLog.Set(Client.LogEntries is List<GameLogEntry> list ? list : new List<GameLogEntry>(Client.LogEntries));
		}
		return _remoteLog;
	}

	string WinnerDisplayName() {
		if (Client.Completion == null || string.IsNullOrEmpty(Client.Completion.WinnerOrganizationId)) {
			return "";
		}
		return Localization.Get($"organization_name.{Client.Completion.WinnerOrganizationId}");
	}

	void OnMenu() {
		_saveMessage = null;
		GameSession.Logic?.Commands.Push(new GS.Game.Commands.PauseCommand());
		_menuOpen = true;
	}

	void OnResume() {
		GameSession.Logic?.Commands.Push(new GS.Game.Commands.UnpauseCommand());
		_menuOpen = false;
	}

	void OnSave() {
		if (GameSession.Logic == null) {
			return;
		}
		GameSession.Logic.VisualState.SaveResult.PropertyChanged -= HandleSaveResultChanged;
		GameSession.Logic.VisualState.SaveResult.PropertyChanged += HandleSaveResultChanged;
		GameSession.Logic.Commands.Push(new GS.Game.Commands.SaveGameCommand());
	}

	void HandleSaveResultChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e) {
		if (GameSession.Logic == null) {
			return;
		}
		var result = GameSession.Logic.VisualState.SaveResult;
		_saveMessage = result.Success
			? Localization.Get("game_menu.save.confirmation")
			: string.Format(Localization.Get("game_menu.save.error"), result.ErrorType);
		GameSession.Logic.VisualState.SaveResult.PropertyChanged -= HandleSaveResultChanged;
		InvokeAsync(StateHasChanged);
	}

	void OnExit() {
		GameSession.Dispose();
		Navigation.NavigateTo("/");
	}

	public void Dispose() {
		_pollCts?.Cancel();
		_pollCts?.Dispose();
		if (_subscribed) {
			Client.Changed -= OnChanged;
			_subscribed = false;
		}
		if (GameSession.Logic != null) {
			GameSession.Logic.VisualState.SaveResult.PropertyChanged -= HandleSaveResultChanged;
		}
	}
}
